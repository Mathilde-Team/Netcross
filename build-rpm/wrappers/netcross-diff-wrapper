#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Wrapper installe dans /usr/bin/netcross-diff par le paquet Debian/RPM.
# Comparaison avant/apres entre deux jeux de captures.
export PYTHONPATH="/usr/share/netcross:${PYTHONPATH:-}"
exec /usr/bin/python3 /usr/share/netcross/cross_capture_diff_cli.py "$@"
