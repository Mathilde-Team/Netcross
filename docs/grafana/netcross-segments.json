  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["netcross"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(netcross_health_score, run)",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "run",
        "options": [],
        "query": {
          "query": "label_values(netcross_health_score, run)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "allValue": ".*",
